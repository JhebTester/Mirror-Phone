<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mirror Phone Agent"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Empareja tu Mac"
            android:layout_marginTop="24dp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnScanQr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="📷  Escanear código QR" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Servidores en tu red"
            android:layout_marginTop="24dp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/emptyServers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Buscando… asegúrate de estar en la misma Wi-Fi."
            android:textStyle="italic"
            android:layout_marginTop="4dp" />

        <ListView
            android:id="@+id/serverList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="80dp"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Conexión manual"
            android:layout_marginTop="24dp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/inputIp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="IP del Mac (192.168.1.42)"
            android:inputType="text" />

        <EditText
            android:id="@+id/inputPort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Puerto"
            android:inputType="number"
            android:text="7878" />

        <EditText
            android:id="@+id/inputPin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="PIN (6 caracteres)"
            android:inputType="textCapCharacters"
            android:maxLength="6" />

        <Button
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Iniciar espejo" />

        <Button
            android:id="@+id/btnStop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:enabled="false"
            android:text="Detener" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Detenido"
            android:textStyle="italic"
            android:layout_marginTop="16dp" />

    </LinearLayout>
</ScrollView>
